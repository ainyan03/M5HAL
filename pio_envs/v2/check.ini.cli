; =============================================================================
; M5HAL — v2 系統 build check envs
;
; <M5HAL_v2.hpp> 直接 include (= M5HALCore singleton + M5_Hal reference 変数、
; S9a 採用後の新 API)。 espidf 環境は xtensa toolchain での Magic Static +
; ctor 副作用 + reference 変数 eager init の link / startup 挙動を build
; check 段階で fence する用途 (実機 startup 確認は S9a 受入条件 11 で別途)。
;
; 対応 stub: test/v2/stub/build_check_{native,arduino,espidf}.cpp
; 共通 API surface: test/v2/build_check/build_check.hpp
;   examples は利用者向けに単独完結・読みやすさを優先する。 CI の compile fence は
;   build_check.hpp へ API 利用形を集約し、native test と framework stub から共有する。
;
; 命名: v2_<purpose>_<chip>[_<framework>][_<variant>]  (version prefix を先頭に置く)
;
; 使い方:
;   pio run -e v2_check_native
;   pio run -e v2_check_esp32_espidf
;   pio run -e v2_check_esp32_espidf_legacy_i2c
;   pio run -e v2_check_esp32_espidf6
;   pio run -e v2_check_native_inline      (inline flip fence)
; =============================================================================

[env:v2_check_native]
extends = common_native
build_src_filter = +<*> +<../test/v2/stub/build_check_native.cpp>

[env:v2_check_esp32_arduino]
extends = common_esp32dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

; Arduino-core 3.x (IDF 5.x era) forward probe via pioarduino — the official
; espressif32 platform tops out at arduino-esp32 2.0.x. See common_esp32_arduino3.
[env:v2_check_esp32_arduino3]
extends = common_esp32dev_arduino3, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_esp32_espidf]
extends = common_esp32dev_espidf5, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32_espidf_legacy_i2c]
extends = common_esp32dev_espidf5, common_espidf
build_flags =
    ${common_esp32.build_flags}
    -DM5HAL_CONFIG_ESPIDF_I2C_MASTER_LEGACY_DRIVER=1
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32_espidf6]
extends = common_esp32dev_espidf6, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32s3_arduino]
extends = common_esp32s3dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_esp32s3_arduino3]
extends = common_esp32s3dev_arduino3, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_esp32s3_espidf]
extends = common_esp32s3dev_espidf5, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32s3_espidf6]
extends = common_esp32s3dev_espidf6, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32c3_arduino]
extends = common_esp32c3dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_esp32c3_espidf]
extends = common_esp32c3dev, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

[env:v2_check_esp32c6_espidf]
extends = common_esp32c6dev, common_espidf
build_src_filter = +<*> +<../test/v2/stub/build_check_espidf.cpp>

; NOTE: esp32h2 / esp32p4 用の env は platform espressif32 v6.12.0 が riscv
; toolchain 選択を c3/c6 のみハードコードしているため未追加。 platform 自体の
; アップグレード (例: pioarduino/espressif32) と board file 整備が前提。

; --- Non-ESP32 Arduino cores (build-check only; no HIL rig for these) -------
; v0 remains ESP32-only, but its translation unit deliberately compiles empty
; on these targets. Keep M5HAL_v0.cpp in every env so this matrix verifies the
; same unfiltered library source set that Arduino builders consume.
[env:v2_check_rp2040_arduino]
extends = common_rp2040dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_rp2350_arduino]
extends = common_rp2350dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_rp2350_arduino.cpp>

[env:v2_check_unor4_minima_arduino]
extends = common_unor4_minima, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_unor4_minima_arduino.cpp>

[env:v2_check_samd51_arduino]
extends = common_samd51dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_stm32f4_arduino]
extends = common_stm32f4dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_nrf52840_arduino]
extends = common_nrf52840dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

[env:v2_check_esp8266_arduino]
extends = common_esp8266dev, common_arduino
build_src_filter = +<*> +<../test/v2/stub/build_check_arduino.cpp>

; --- M5Utility platform_detect override fence --------------------------------
; Compiles the M5UTILITY_HAS_USABLE_CHRONO=0 integrator override on host, so
; the logging path's no-<chrono> branch (custom elapsed_time_t +
; m5::utility::millis() log clock, log/library_log.*) cannot rot without any
; embedded toolchain in the loop. Scope note: on native the time source stays
; CHRONO, so compatibility_feature.cpp still uses <chrono>/<thread> — this env
; does NOT prove a fully <chrono>-less build (that additionally needs a
; non-chrono M5UTILITY_TIME_SOURCE, which the auto-detection selects on
; Arduino cores).
[env:v2_check_native_nochrono]
extends = common_native
build_flags =
    ${common_native.build_flags}
    -DM5UTILITY_HAS_USABLE_CHRONO=0
build_src_filter = +<*> +<../test/v2/stub/build_check_native.cpp>

; --- v2 inline flip build check ---------------------------------------------
; Forces M5HAL_V0_INLINE=0 + M5HAL_V2_INLINE=1 (default は逆) で build。
; v2 を inline 化した時に m5::hal::* lookup が壊れないことを CI で fence。
; v0 source は inline 前提で書かれているため build 対象外 (M5HAL_v0.cpp 除外)。
; See spec/design/v0_v2_coexistence.md for the inline namespace switch policy.
[env:v2_check_native_inline]
extends = common_native
build_flags =
    ${common_native.build_flags}
    -DM5HAL_V0_INLINE=0
    -DM5HAL_V2_INLINE=1
build_src_filter = +<*> -<M5HAL_v0.cpp> +<../test/v2/stub/build_check_v2inline.cpp>
