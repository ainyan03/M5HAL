# ESP-IDF sdkconfig defaults for M5HAL's own PlatformIO espidf project builds
# (the v2_check_*_espidf compile fences and the v2_hil_* device fixtures). This
# applies ONLY when M5HAL is the PlatformIO project; consumers that pull M5HAL in
# as a library/component keep their own sdkconfig.
#
# CONFIG_FREERTOS_HZ=1000: the I2C slave HIL device (experiments/v2/test/i2c_slave)
# polls the accessor with delayMs(1) waits = one FreeRTOS tick. At the IDF default
# 100 Hz that tick is 10 ms, which dominated the slave's per-transaction response
# latency and made an occasional readback overrun the master's tolerance. A 1 ms
# tick keeps the polling fine enough for the 2-board HIL matrix to pass clean.
# Harmless for the compile-only check envs.
CONFIG_FREERTOS_HZ=1000

# TCP tuning for the remote-bus stream path (RemoteServerTCP examples). The IDF
# defaults (TCP_WND 5744 = 4xMSS, no SACK) turn a single lost WiFi segment into
# a full host-side RTO stall: with only 4 segments in flight there are rarely
# enough dup-ACKs for fast retransmit, so every loss costs ~250 ms. Measured on
# Core2 (2026-07-03): remote I2S throughput 58-65 KB/s with 20-25% of host bytes
# being retransmissions; with a 16xMSS window + SACK the same link sustains the
# 44.1 kHz stereo nominal rate (176.4 KB/s) with headroom (~190 KB/s ceiling).
# RAM cost is per open TCP connection and only while data is queued.
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=17280
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
